generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  username     String        @unique
  email        String        @unique
  password     String
  avatarColor  String        @default("#3B82F6")
  initials     String?       @db.VarChar(3)   // pastille : "NBO" plutot que "N"
  avatarRing   String?       @db.VarChar(7)   // null = liseré d'accent, "none" = aucun, sinon #RRGGBB
  createdAt    DateTime      @default(now())

  /// L'adresse a-t-elle été vérifiée ?
  ///
  /// Une faute de frappe à l'inscription est la seule panne qui ne se signale
  /// nulle part : le joueur ne reçoit ni rappel, ni bilan, ni lien de mot de
  /// passe oublié, et personne ne s'en aperçoit — les courriels partent sans
  /// erreur vers une adresse qui n'existe pas. On envoie donc un lien à
  /// l'inscription, et tant qu'il n'est pas suivi, ce champ reste faux.
  ///
  /// Il ne ferme aucune porte, et c'est délibéré : entre amis, verrouiller un
  /// compte parce que son propriétaire n'a pas cliqué sur un lien serait
  /// absurde. Il sert à afficher un bandeau dans l'application — le seul
  /// endroit où une adresse fautive peut être corrigée, puisque par définition
  /// le courriel n'arrive pas — et à lister les retardataires côté
  /// administration.
  ///
  /// Faux par défaut, donc pour les inscriptions à venir. Les joueurs déjà là
  /// sont passés à vrai par la migration : leurs adresses fonctionnent, c'est
  /// prouvé chaque vendredi, et leur poser un bandeau serait leur reprocher
  /// une faute qu'ils n'ont pas commise.
  emailVerifie   Boolean     @default(false)
  emailVerifieAt DateTime?

  /// Ce que le joueur accepte de recevoir, et s'il joue encore.
  ///
  /// Les deux premiers sont vrais par defaut : on s'inscrit pour jouer, donc on
  /// accepte d'etre prevenu. Ils se coupent depuis un lien au bas de chaque
  /// courriel, sans connexion — quelqu'un qui ne revient plus ne se connectera
  /// pas pour aller decocher une case, et c'est justement lui qu'il faut
  /// pouvoir servir.
  ///
  /// `enPause` est plus large : plus aucun courriel, et le joueur sort du
  /// classement et du jeu. Rien n'est efface pour autant — ses pronostics, ses
  /// points et son compte restent, et il suffit de remettre ce champ a faux
  /// pour que tout revienne. C'est la difference entre partir et effacer son
  /// passage, et seule la premiere se fait en un clic.
  mailRappels  Boolean       @default(true)    // le rappel du vendredi
  mailBilan    Boolean       @default(true)    // le bilan du lundi
  enPause      Boolean       @default(false)
  pauseAt      DateTime?                       // quand, pour pouvoir le dire

  /// Ce compte est-il tenu par une personne ?
  ///
  /// Un seul le porte : Bob le poulpe, qui signe le message de bienvenue dans
  /// le salon. Un message a besoin d'un auteur qui existe en base — c'est ce
  /// qui lui donne sa pastille et son pseudo — donc Bob a un compte, inerte :
  /// mot de passe aleatoire que personne ne connait, aucun courriel, en pause.
  ///
  /// Ce champ existe pour une seule raison : un compte apparait dans le
  /// classement, et un poulpe a zero point au bas du classement des copains
  /// serait absurde. `leaderboard.controller.js` et la liste d'administration
  /// l'ecartent donc.
  bot          Boolean       @default(false)

  predictions  Prediction[]
  /// Les messages ecrits et les messages recus.
  ///
  /// Deux relations vers la meme table, donc deux noms : Prisma ne sait plus
  /// deviner laquelle est laquelle des qu'il y en a plus d'une. Les noms sont
  /// internes au schema et ne changent rien en base.
  messages     Message[] @relation("Ecrits")
  recus        Message[] @relation("Recus")
  lectures     Lecture[]
  avatar       UserAvatar?
  authTokens   AuthToken[]
  reminders    Reminder[]

  @@map("users")
}

/// Photo de profil, volontairement dans sa propre table.
///
/// Si l'image vivait dans `users`, elle partirait dans chaque reponse qui
/// renvoie un utilisateur — /auth/me, le classement, chaque message du salon —
/// puisque le middleware d'authentification relit l'utilisateur entier. Isolee
/// ici, elle n'est lue que par la route qui la sert.
///
/// Le navigateur redimensionne en 128x128 avant l'envoi : quelques kilo-octets
/// par joueur, rien qui justifie un hebergement d'images.
model UserAvatar {
  userId    Int      @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String   @default("image/webp")
  updatedAt DateTime @updatedAt

  @@map("user_avatars")
}

model Team {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  shortName String  @unique
  logo      String?
  city      String?

  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")

  @@map("teams")
}

model Match {
  id           Int           @id @default(autoincrement())
  externalId   String?       @unique   // ID depuis l'API externe
  round        Int                     // Journée (1-26)
  season       String        @default("2026-2027")
  homeTeam     Team          @relation("HomeTeam", fields: [homeTeamId], references: [id])
  homeTeamId   Int
  awayTeam     Team          @relation("AwayTeam", fields: [awayTeamId], references: [id])
  awayTeamId   Int
  kickoff      DateTime                // Date/heure du match
  status       MatchStatus   @default(SCHEDULED)
  homeScore    Int?                    // Score final équipe domicile
  awayScore    Int?                    // Score final équipe extérieure
  venue        String?
  broadcaster  String?
  composition  Json?
  compositionAt  DateTime?

  /// La meteo prevue a l'heure du coup d'envoi, relevee sur Open-Meteo.
  ///
  /// En JSON et non en colonnes separees : c'est un bloc qu'on affiche tel quel
  /// et sur lequel on ne fait ni tri ni filtre. Le jour ou l'on voudrait
  /// chercher « les matchs sous la pluie », ce serait a revoir — et ce jour n'a
  /// aucune raison d'arriver.
  ///
  /// `meteoAt` dit quand le releve a ete fait, et il compte autant que la
  /// prevision : celle de mardi pour samedi n'est pas celle de vendredi pour
  /// samedi, et l'ecran doit pouvoir donner son age.
  ///
  /// Vide pour une rencontre lointaine, et ce n'est pas une panne : au-dela
  /// d'une dizaine de jours, aucune prevision ne vaut rien.
  meteo          Json?
  meteoAt        DateTime?
  stats          Json?
  statsAt        DateTime?
  featured     Boolean       @default(false)
  predictions  Prediction[]
  updatedAt    DateTime      @updatedAt

  @@map("matches")
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
}

model Prediction {
  id             Int      @id @default(autoincrement())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         Int
  match          Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId        Int
  homeScorePred  Int               // Score prédit domicile
  awayScorePred  Int               // Score prédit extérieur
  points         Int?              // Points attribués après résultat
  basePoints     Int?              // le bareme seul, de 0 a 3
  joker          Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, matchId])
  @@map("predictions")
}

/// Salon de discussion du groupe — une seule conversation, tous joueurs confondus.
/// Les messages disparaissent avec le compte de leur auteur, comme ses pronostics.
model Message {
  id        Int      @id @default(autoincrement())
  user      User     @relation("Ecrits", fields: [userId], references: [id], onDelete: Cascade)
  userId    Int

  /// A qui ce message est-il adresse ?
  ///
  /// Vide, c'est le Comptoir : tout le monde le lit, et c'est le seul cas qui
  /// existait jusqu'ici — les messages deja en base restent donc exactement ce
  /// qu'ils etaient, sans migration de donnees.
  ///
  /// Rempli, c'est un message prive. Le fil entre deux joueurs est l'ensemble
  /// des messages ou l'un est l'auteur et l'autre le destinataire, dans les
  /// deux sens. Pas de table de conversations ni de participants : a huit
  /// joueurs, ce serait de la plomberie pour un probleme qu'on n'a pas, et une
  /// table de plus a tenir a jour est une occasion de plus de se tromper.
  ///
  /// Les messages prives ne sont lisibles que par leurs deux interlocuteurs.
  /// L'administration ne les voit pas — sa moderation ne porte que sur le
  /// Comptoir —, et ce n'est pas un oubli : un salon public se modere, une
  /// conversation entre deux personnes ne se lit pas.
  destinataire   User?  @relation("Recus", fields: [destinataireId], references: [id], onDelete: Cascade)
  destinataireId Int?

  body      String   @db.VarChar(1000)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([destinataireId, userId])
  @@map("messages")
}

/// Ou en est chacun dans sa lecture, fil par fil.
///
/// La date de derniere lecture vivait dans le navigateur, et ca se voyait : on
/// lisait sur son telephone, le PC continuait d'afficher la pastille. C'etait
/// supportable avec un seul salon ; avec huit fils, ce serait huit pastilles
/// fausses.
///
/// `fil` vaut 0 pour le Comptoir, et l'identifiant de l'autre joueur pour un fil
/// prive. Un entier plutot qu'une seconde cle etrangere : le Comptoir n'est pas
/// un utilisateur, et lui inventer une ligne dans `users` pour que la contrainte
/// tombe juste serait payer cher une elegance de schema.
model Lecture {
  id     Int      @id @default(autoincrement())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
  fil    Int                      // 0 = le Comptoir, sinon l'autre joueur
  luAt   DateTime @default(now())

  @@unique([userId, fil])
  @@map("lectures")
}

/// Jetons a usage unique envoyes par e-mail : reinitialisation de mot de passe,
/// et verification d'adresse a l'inscription.
///
/// On ne garde que l'empreinte SHA-256 du jeton, jamais le jeton lui-meme.
/// Ainsi une fuite de la base ne permet pas de prendre la main sur un compte,
/// puisque le lien envoye reste introuvable a partir de ce qui est stocke.
model AuthToken {
  id        Int       @id @default(autoincrement())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  kind      TokenKind
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, kind])
  @@map("auth_tokens")
}

enum TokenKind {
  PASSWORD_RESET
  EMAIL_VERIFY
}

/// Instantané du classement Top 14, relu périodiquement sur une source externe.
/// L'application lit toujours cette table, jamais le site : si la source change
/// de structure, la page continue d'afficher le dernier classement connu.
model LeagueTable {
  id        Int      @id @default(autoincrement())
  season    String   @unique @default("2026-2027")
  data      Json                         // tableau des équipes, une entrée par club
  source    String   @default("allrugby")
  fetchedAt DateTime @default(now())

  @@map("league_table")
}
/// Trace des rappels deja envoyes.
///
/// Elle n'existe que pour garantir qu'on n'ecrit qu'une fois a chacun par
/// journee. La contrainte d'unicite fait tout le travail : on insere avant
/// d'envoyer, et si l'insertion echoue c'est que le rappel est deja parti.
/// L'unicite est ainsi garantie par la base, pas par la regularite du
/// planificateur — un redemarrage du serveur un vendredi soir ne peut donc pas
/// produire un second courriel.
model Reminder {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  round     Int
  kind      String   @default("PRONOS_MANQUANTS")
  sentAt    DateTime @default(now())

  @@unique([userId, round, kind])
  @@index([round])
  @@map("reminders")
}

/// Journal des taches automatiques : une ligne par tache, ecrasee a chaque
/// passage.
///
/// Elle repond a une seule question — quand cette tache a-t-elle reussi pour la
/// derniere fois ? — et cette question n'avait aucune reponse. Les sauvegardes
/// n'ont rien envoye pendant des jours sans que rien ne le dise : l'envoi
/// restait suspendu au lieu d'echouer, donc le `catch` ne se declenchait pas, et
/// les journaux de la console disparaissent au redemarrage du conteneur.
///
/// Pas d'historique, volontairement. Ce qu'on veut savoir est l'etat present ;
/// un historique qu'on ne consulte jamais est une table qui grossit pour rien.
///
/// `lastErrorAt` est conserve a cote de `lastSuccessAt` plutot qu'a la place :
/// une tache qui tourne mais echoue et une tache qui ne tourne plus du tout sont
/// deux pannes differentes, et la reponse n'est pas la meme.
model JobRun {
  id            Int       @id @default(autoincrement())
  job           String    @unique           // "sauvegarde", "classement", ...
  lastSuccessAt DateTime?
  lastErrorAt   DateTime?
  lastError     String?   @db.VarChar(500)
  details       Json?                       // ce que la tache a fait : volumes, journee, taille
  updatedAt     DateTime  @updatedAt

  @@map("job_runs")
}

/// Les adresses interdites d'inscription.
///
/// Elle ne contient pas des comptes mais des adresses : bannir ne touche aucun
/// compte existant, cela ferme seulement la porte d'entree. Un compte se met en
/// pause ou se supprime, ce sont deux autres gestes — voir
/// `services/bannissement.service.js`, qui explique pourquoi les trois sont
/// separes.
///
/// Deux colonnes pour une meme adresse, et c'est le coeur du sujet. `email` est
/// la forme saisie, celle que l'administrateur reconnait dans la liste. `cle`
/// est sa forme normalisee — minuscules, et chez Gmail les points et le
/// `+suffixe` retires — et c'est elle qui porte l'unicite et la comparaison.
/// Sans cette seconde colonne, `jean.dupont+rugby@gmail.com` reviendrait le
/// lendemain du bannissement de `jeandupont@gmail.com`, qui est pourtant la
/// meme boite.
model AdresseBannie {
  id        Int      @id @default(autoincrement())
  email     String                            // telle que saisie, pour l'affichage
  cle       String   @unique                  // normalisee, pour la comparaison
  motif     String?  @db.VarChar(200)
  parEmail  String?                           // qui a ferme la porte
  createdAt DateTime @default(now())

  @@map("adresses_bannies")
}

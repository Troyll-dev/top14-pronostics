// ---------------------------------------------------------------------------
// À AJOUTER dans backend/src/prisma/schema.prisma — ne remplace pas le fichier.
// Trois lignes, dans deux modèles. Toutes facultatives ou avec valeur par
// défaut : aucune migration destructrice, rien à confirmer.
// ---------------------------------------------------------------------------

model Match {
  // … tout ce qui existe déjà, inchangé …

  venue        String?
  broadcaster  String?
  featured     Boolean   @default(false)   // match de la semaine (×3)

  // … la suite inchangée …
}

model Prediction {
  // … tout ce qui existe déjà, inchangé …

  points         Int?              // total attribué, multiplicateur compris
  basePoints     Int?              // le barème seul, de 0 à 3
  joker          Boolean  @default(false)

  // … la suite inchangée …
}

// Pourquoi deux colonnes de points plutôt qu'une.
//
// `points` se somme : c'est ce que le classement additionne, et tout le code
// existant continue de marcher sans être touché.
//
// `basePoints` se compte : « combien de scores exacts » ne doit pas se lire sur
// un total multiplié, sinon un score exact joué en joker vaut 6 et n'est plus
// reconnu comme un score exact.
//
//   npx prisma db push --schema=src/prisma/schema.prisma
//   npx prisma generate --schema=src/prisma/schema.prisma

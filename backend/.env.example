# Base de données PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/top14_pronostics"

# JWT Secret (générer avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET="changez_ce_secret_en_production"
JWT_EXPIRES_IN="7d"

# Port du serveur
PORT=3001

# API Rugby (api-sports.io) — optionnel pour import auto des résultats
# Inscrivez-vous sur https://rapidapi.com/api-sports/api/api-rugby
RUGBY_API_KEY=""
RUGBY_API_HOST="api-rugby.p.rapidapi.com"

# Environnement
NODE_ENV="development"

# URL du frontend (pour CORS)
FRONTEND_URL="http://localhost:5173"
